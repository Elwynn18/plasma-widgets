#: contents/ui/main.qml:274
msgid "Claude Code sign-in not found. Run “claude” in a terminal and sign in."
msgstr ""
"No se encontró el inicio de sesión de Claude Code. Ejecuta «claude» en una "
"terminal e inicia sesión."

#: contents/ui/main.qml:276
msgid ""
"Your Claude Code sign-in has expired. Open Claude Code once to renew it."
msgstr ""
"Tu inicio de sesión de Claude Code ha caducado. Abre Claude Code una vez "
"para renovarlo."

#: contents/ui/main.qml:278
msgid "Cannot reach Anthropic's servers. Check your connection."
msgstr ""
"No se puede contactar con los servidores de Anthropic. Comprueba tu conexión."

#: contents/ui/main.qml:280
msgid "Too many requests. Trying again later."
msgstr "Demasiadas solicitudes. Se volverá a intentar más tarde."

#: contents/ui/main.qml:282
msgid "The “curl” program is required. Install it with your package manager."
msgstr "Se necesita el programa «curl». Instálalo con tu gestor de paquetes."

#: contents/ui/main.qml:284
msgid ""
"The “jq” or “python3” program is required. Install one with your package "
"manager."
msgstr ""
"Se necesita el programa «jq» o «python3». Instala uno de ellos con tu gestor "
"de paquetes."

#: contents/ui/main.qml:286
msgid "Unexpected server response (HTTP %1)."
msgstr "Respuesta inesperada del servidor (HTTP %1)."

#: contents/ui/main.qml:288
