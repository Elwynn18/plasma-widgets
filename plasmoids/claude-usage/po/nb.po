msgstr "For mange forespørsler. Prøver igjen senere."

#: contents/ui/main.qml:282
msgid "The “curl” program is required. Install it with your package manager."
msgstr "Programmet «curl» kreves. Installer det med pakkebehandleren."

#: contents/ui/main.qml:284
msgid ""
"The “jq” or “python3” program is required. Install one with your package "
"manager."
msgstr ""
"Programmet «jq» eller «python3» kreves. Installer ett av dem med "
"pakkebehandleren."

